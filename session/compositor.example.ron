// Example ~/.config/crownos/compositor.ron
//
// Copy it there and edit. Every field has a default, so delete anything you do
// not want to change -- an empty `()` is a valid file.
//
// Watched live: a save takes effect without a restart. Note that a file which
// does not PARSE silently reverts this whole section to defaults, with no error
// anywhere -- so if an edit appears to do nothing, check the syntax first.
// crownpositor logs to stderr, not the journal.
(
    // Tiling | Floating. Which tiling algorithm is used is not a config choice
    // any more; `toggle-layout-mode` switches it at runtime.
    layout: Tiling,

    focus_follows_mouse: true,

    // The desktop. crownpositor spawns these once, after the socket is live and
    // the outputs exist, with WAYLAND_DISPLAY already pointing at itself.
    //
    // This is already the default, so you only need the field to change it. An
    // empty list gives you a bare compositor with no bar, dock or notifications.
    // Anything on PATH works; order is file order.
    startup: [
        "crownbar",
        "crowndock",
        "crownotify",
        // "crowndictator",   // downloads 700 MB-2.5 GB of model weights on first run
    ],

    window_rules: [
        (app_id: "pavucontrol", floating: true),
    ],

    outputs: [
        // (name: "eDP-1", scale: 2.0, position: (0, 0)),
    ],
)

// Keybindings are NOT in this file any more -- they moved to `keybinds.ron`:
//
//     (
//         custom_keybinds: [
//             (keys: "Super+Return", action: "spawn foot"),
//         ],
//     )
//
// Careful: a non-empty `custom_keybinds` REPLACES the entire default table
// rather than adding to it. One row means one binding in total -- including
// losing Super+Shift+E to quit. List every chord you want, or leave it empty to
// keep the 32 defaults. See docs/keybindings.md.
